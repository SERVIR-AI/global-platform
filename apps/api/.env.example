# Copy to apps/api/.env and fill in what you need. Everything here is optional:
# the app runs open until you enable OAuth (see the auth section at the bottom).
# Deployed, the entrypoint refuses to boot unless OAuth is on or
# GRP_ALLOW_ANONYMOUS=1 is set.
#
# WITHOUT ANY KEYS you still get: platform_capabilities, all feeds (live NOAA
# etc.), the ENTIRE risk pack loop (deterministic geo compute -> groundedness
# gate -> receipt), receipts/resolver/embeds/runbook. WITH keys you add: the
# food-security corpus (embeddings), LLM drafting paths (/api/chat,
# compose_run), and the platform-side briefs.

# --- LLM providers (set whichever you use) ----------------------------------
# Default provider when a request doesn't specify one: claude | openai | gemini
DEFAULT_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default model per provider (optional overrides)
# CLAUDE_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- embeddings (the food-security corpus needs these to match) -------------
# The corpus records which embedder built it; search declines on a mismatch.
# The seeded demo corpus uses openai:text-embedding-3-small.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- retrieval --------------------------------------------------------------
# Relevance floor for corpus hits (0..1). The demo corpus is calibrated at 0.5.
# RAG_MIN_RELEVANCE=0.5

# --- design tokens (optional; falls back to the committed theme) ------------
# FIGMA_TOKEN=

# --- per-query cost line in the trace: USD per million tokens (0 = unpriced) -
# PRICE_IN=0
# PRICE_OUT=0

# --- endpoints (override only for custom/proxy deployments) -----------------
# CLAUDE_BASE_URL=https://api.anthropic.com/v1/
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- workspace paths (default to repo-root cache/ and conf/) ----------------
# CACHE_DIR=
# TIFFS_DIR=
# TRACES_DIR=

# --- browser origins allowed to call the API (JSON array) -------------------
# CORS_ORIGINS=["http://localhost:8080"]

# Authentication for the standard app and the MCP transport (off unless set):
# with GRP_OAUTH_ENABLED=1 the app requires an AuthKit login and /mcp refuses
# anonymous callers. Off = the whole app is open, which is how local dev and
# the test suite run (tests must run with it off).
# GRP_OAUTH_ENABLED=1
# GRP_PUBLIC_URL=http://127.0.0.1:8001
# GRP_AUTHKIT_DOMAIN=https://your-project-12345.authkit.app

# Standard-app login via AuthKit hosted login: the Connect OAuth application's
# client id (PKCE public client, no secret). Empty = MCP-only, no login routes.
# GRP_AUTHKIT_CLIENT_ID=

# Local admin only: WorkOS API key for scripts/manage_workos_users.py (inviting
# users). From Dashboard -> Developer -> API keys, SAME environment as the
# users being managed. Never set this in the deployed service.
# WORKOS_API_KEY=sk_...
