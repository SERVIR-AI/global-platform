# Copy to apps/api/.env and fill in the providers you use.

# Default provider when a request doesn't specify one: claude | openai | gemini
DEFAULT_PROVIDER=gemini

# Provider credentials (set whichever you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default model per provider (optional overrides)
CLAUDE_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash

# Each provider's OpenAI-compatible endpoint (override to use a custom endpoint)
# CLAUDE_BASE_URL=https://api.anthropic.com/v1/
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Per-query cost line in the trace: USD per million tokens (0 = unpriced)
# PRICE_IN=0
# PRICE_OUT=0

# Workspace paths (default to repo-root cache/ and conf/; override if relocated)
# CACHE_DIR=
# TIFFS_DIR=
# TRACES_DIR=
# PROMPTS_PATH=
# TIFFS_CONFIG_PATH=

# Browser origins allowed to call the API (JSON array)
# CORS_ORIGINS=["http://localhost:8080"]

# OAuth 2.1 on the MCP transport (off unless GRP_OAUTH_ENABLED is set)
# GRP_OAUTH_ENABLED=1
# GRP_PUBLIC_URL=http://127.0.0.1:8001
# GRP_AUTHKIT_DOMAIN=https://your-project-12345.authkit.app

# Standard-app login via AuthKit hosted login: the Connect OAuth application's
# client id (PKCE public client, no secret). Empty = MCP-only, no login routes.
# GRP_AUTHKIT_CLIENT_ID=
