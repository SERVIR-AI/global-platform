# What gcloud uploads as build context for 'gcloud run deploy --source .'. gcloud does
# not read .dockerignore and follows gitignore rules, where a child cannot be re-included
# under an excluded parent, so this is a block-list of everything the Dockerfile never
# copies. Keep it in step with .dockerignore.
.git
.gitignore
.github
.venv
**/.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
**/node_modules
apps/web/dist
apps/api/tests
apps/api/scripts
scripts

# Runtime data: mounted on the host, never a build input.
cache
conf/*.contrib.yml
conf/.contrib.lock
conf/methods

# Local-only: secrets, documents, data drops, scratch.
**/.env
**/.env.*
docs
styleguide
grp_mvp
MangroveData
landcover
mural
feedback
BUILD_PLAN.md
CLAUDE.md
gitleaks-report.json
*.pdf
*.xlsx
*.csv
*.md
e2e_*.json
**/.DS_Store
