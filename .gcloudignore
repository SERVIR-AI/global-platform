# What gcloud uploads as build context for 'gcloud run deploy --source .'. gcloud reads
# this file and not .dockerignore, so it mirrors .dockerignore line for line.
*
!pyproject.toml
!uv.lock
!apps/api/pyproject.toml
!apps/api/src
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/index.html
!apps/web/src
!apps/web/public
!apps/web/tsconfig.json
!apps/web/tsconfig.app.json
!apps/web/tsconfig.node.json
!apps/web/vite.config.ts
!conf
!deploy
!.claude/skills/trace-emit
!.claude/skills/trace-visualize

# Runtime data the contribution gate owns: mounted on the host, never baked.
conf/*.contrib.yml
conf/.contrib.lock
conf/methods

# Never, anywhere in the context.
**/__pycache__
**/*.pyc
**/.env
**/.env.*
**/.DS_Store
