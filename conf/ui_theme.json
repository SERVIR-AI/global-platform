{
  "id": "grp",
  "version": "v0",
  "description": "The Global Risk Platform design language, built on the official SERVIR identity (styleguide/). Single source of truth: the web app imports generated artifacts from this file, and ui.design serves it. Edit here, regenerate — never hand-edit the generated files.",
  "brand": {
    "name": "SERVIR",
    "source": "styleguide/identity-guidelines.png + SERVIR_Style_guide/ (2026 identity)",
    "blue": "#2380b0",
    "green": "#91af3d",
    "ink": "#1c212a",
    "slate": "#485e88",
    "logo_variants": [
      "colour on dark",
      "colour on light",
      "white/mono"
    ],
    "usage": [
      "brand blue leads; brand green is the supporting accent",
      "the identity's dark navy is for headers/hero surfaces, not body text backgrounds",
      "brand green is NOT the verified colour — see trust_rules; a brand accent must never read as a verdict",
      "hub apps replace the wordmark with their own; the platform mark stays a neutral built-with credit"
    ],
    "logo": {
      "data_uri": "data:image/png;base64,",
      "alt": "SERVIR",
      "intrinsic_size": "240x48",
      "variants": [
        "colour (default, transparent PNG)",
        "white/mono for dark headers"
      ],
      "usage": [
        "always render it in the platform header, next to the domain name",
        "never recolour, distort or crop the mark",
        "self-contained data URI — no network fetch, works in any page"
      ]
    }
  },
  "palette": {
    "base-100": "#fbfcfd",
    "base-200": "#f1f4f7",
    "base-300": "#e0e6ec",
    "base-content": "#1c212a",
    "primary": "#2380b0",
    "primary-content": "#f7fbfd",
    "secondary": "#91af3d",
    "secondary-content": "#12180a",
    "accent": "#485e88",
    "accent-content": "#f6f8fc",
    "neutral": "#1c212a",
    "neutral-content": "#eef2f5",
    "info": "#2380b0",
    "success": "#1f7a4d",
    "warning": "#a06a08",
    "error": "#9b2c2c"
  },
  "trust_rules": {
    "success_reserved_for": "server_verified",
    "default_state": "unverified",
    "chip_states": [
      "pass",
      "fail",
      "not_run"
    ],
    "verified_requires_receipt_link": true,
    "never": [
      "a verdict may not be set by the host/client — it resolves from the server",
      "declines, declared gaps, honest zeros and ADJUSTED labels may not be suppressed",
      "no partner/agency logo packs; only a neutral built-with mark carrying a receipt link"
    ]
  },
  "semantic": {
    "verified": {
      "role": "success",
      "meaning": "server-verified against registered evidence"
    },
    "caution": {
      "role": "warning",
      "meaning": "adjusted by a human, model-output, or a declared gap"
    },
    "declined": {
      "role": "error",
      "meaning": "refused, with a stated cause"
    },
    "neutral": {
      "role": "base-content",
      "meaning": "unverified / informational — the default"
    }
  },
  "validation_levels": {
    "multi-agency-consensus": "verified",
    "peer-reviewed": "verified",
    "single-agency": "neutral",
    "model-output": "caution"
  },
  "provenance": {
    "section_edges": [
      "#2380b0",
      "#91af3d",
      "#c98a12",
      "#7c5cbf"
    ],
    "parse_edge": "#7c5cbf",
    "cite_edge": "#8b98a8"
  },
  "components": {
    "note": "The inventory ui.catalog exposes. Trust classes decide delivery: receipt_bound surfaces are EMBEDDED (verdict resolves server-side, never a prop); input surfaces emit a human judgement but never render their own verdict; presentational chrome may ship as copy-in recipes.",
    "provenance_graph": {
      "trust_class": "receipt_bound",
      "delivery": "embed",
      "source": "apps/web Provenance/",
      "binds": "receipt_id",
      "embeddable": true,
      "renders": "question -> parse -> retrieval feeds -> chunks in documents -> the gate -> claims, with hover tracing"
    },
    "crop_calendar_editor": {
      "trust_class": "input",
      "delivery": "embed",
      "source": "apps/web ChatArea/CalendarPanel",
      "emits": "calendar override (ADJUSTED, target-pinned)",
      "embeddable": false,
      "status": "embed pending — emits an override via postMessage; not yet decoupled"
    },
    "groundedness_strip": {
      "trust_class": "receipt_bound",
      "delivery": "embed",
      "source": "apps/web ChatArea/Brief",
      "binds": "report_id"
    },
    "source_card": {
      "trust_class": "receipt_bound",
      "delivery": "recipe",
      "source": "apps/web ChatArea/Brief",
      "requires": "doc_id + archived copy"
    },
    "decline_card": {
      "trust_class": "receipt_bound",
      "delivery": "recipe",
      "source": "apps/web ChatArea/Brief"
    },
    "validation_badge": {
      "trust_class": "presentational",
      "delivery": "recipe",
      "maps": "validation_levels"
    },
    "hazard_map": {
      "trust_class": "presentational",
      "delivery": "embed",
      "source": "apps/web Maps/ (flood/risk)",
      "status": "generic — risk pack"
    },
    "chat_shell": {
      "trust_class": "presentational",
      "delivery": "recipe",
      "source": "apps/web ChatArea/",
      "status": "generic scaffold"
    },
    "platform_header": {
      "trust_class": "presentational",
      "delivery": "recipe",
      "required": true,
      "purpose": "SERVIR logo + the domain name — REQUIRED on every page built on this platform",
      "data": "domain_name (from the pack manifest's display_name); logo + platform name are substituted for you"
    }
  },
  "typography": {
    "font_sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font_mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "numeric": "tabular-nums for any aligned figures"
  },
  "radii": {
    "box": "0.5rem",
    "field": "0.375rem",
    "selector": "0.5rem"
  },
  "voice": {
    "decline": "The system declined to answer — declining beats guessing.",
    "adjusted": "ADJUSTED by the requester (not the hub default)",
    "hub_default": "hub default configuration",
    "honest_zero": "0 matched — declared as a gap, not hidden",
    "unverified": "unverified by this platform",
    "claim_scope": "verified = every cited claim traces to the evidence pack; NOT the truth of the underlying sources",
    "retrieved_uncited": "retrieved, not cited by any claim"
  },
  "product": {
    "platform_name": "SERVIR Global Risk Platform",
    "rule": "Every UI built on this platform MUST show the platform header: the SERVIR logo plus the DOMAIN name (e.g. 'Food Security Platform'). Get the domain's display_name from the pack manifest. A hub's own branding sits alongside, never replacing the attribution.",
    "resolver": {
      "base": "http://localhost:8001",
      "receipt": "/api/resolve/receipt/{receipt_id}",
      "report": "/api/resolve/report/{report_id}",
      "pack": "/api/resolve/pack/{pack_id}",
      "note": "Trust chrome resolves verdicts here at VIEW time (a browser cannot call an MCP tool). Paths are relative to `base`; recipes ship with `base` already prefixed. Use hostnames as given — to a browser localhost and 127.0.0.1 are different origins, and a mismatch is a CORS failure that fails closed to 'unverified'."
    },
    "embed_base": {
      "url": "http://localhost:5173",
      "path": "/?embed={component}&receipt_id={receipt_id}",
      "note": "The web app renders a single component standalone in embed mode. Point embed_base.url at wherever the platform UI is served; it resolves its data from /api/resolve/* at view time, so the verdict is never frozen."
    }
  }
}
